{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "IdempotencyCleanup": {
    "Retention": "1.00:00:00",
    "Interval": "01:00:00"
  }
}
