{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LedgerCore",
    "Audience": "LedgerCore.Api",
    "LifetimeMinutes": 60
  },
  "Fees": {
    "EUR": { "Type": "Percentage", "Rate": 0.005, "Minimum": 0.50 },
    "USD": { "Type": "Flat", "Amount": 1.00 },
    "TRY": {
      "Type": "Tiered",
      "Tiers": [
        { "UpTo": 1000, "Fee": 5.00 },
        { "UpTo": 10000, "Fee": 15.00 },
        { "Fee": 25.00 }
      ]
    }
  }
}
