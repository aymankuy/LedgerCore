# Optional. Copy to .env (gitignored) to override the local-only defaults in docker-compose.yml.
# Changing APP_DB_PASSWORD after the first start requires `docker compose down -v`,
# because the login already exists in the database volume with the old password.
MSSQL_SA_PASSWORD=
APP_DB_PASSWORD=
ADMIN_PASSWORD=
DEMO_PASSWORD=
JWT_SIGNING_KEY=
