        <StmtSimple StatementText="SELECT e.Id AS EntryId,&#xD;&#xA;           e.TransactionId,&#xD;&#xA;           t.Type,&#xD;&#xA;           t.ReferenceId,&#xD;&#xA;           t.Description,&#xD;&#xA;           s.Amount,&#xD;&#xA;           @OpeningBalance + SUM(s.Amount) OVER (ORDER BY e.CreatedAtUtc, e.Id ROWS UNBOUNDED PRECEDING) AS BalanceAfter,&#xD;&#xA;           e.CreatedAtUtc&#xD;&#xA;    FROM dbo.LedgerEntries AS e&#xD;&#xA;    JOIN dbo.LedgerTransactions AS t ON t.Id = e.TransactionId&#xD;&#xA;    CROSS APPLY (SELECT CASE e.Direction WHEN 2 THEN e.Amount ELSE -e.Amount END AS Amount) AS s&#xD;&#xA;    WHERE e.AccountId = @AccountId&#xD;&#xA;      AND e.CreatedAtUtc &gt;= @FromUtc&#xD;&#xA;      AND e.CreatedAtUtc &lt; @ToUtc&#xD;&#xA;    ORDER BY e.CreatedAtUtc, e.Id" StatementId="3" StatementCompId="5" StatementType="SELECT" StatementSqlHandle="0x090081B67D9CA47BC4FEF021F501167523BB0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1717581157" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="81.0322" StatementEstRows="28372.5" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE6DA84351A95EC84" QueryPlanHash="0x6EE2BB34706702D3" CardinalityEstimationModelVersion="160">
