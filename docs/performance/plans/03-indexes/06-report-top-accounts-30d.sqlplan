<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT TOP (@Top)&#xd;&#xa;           e.AccountId,&#xd;&#xa;           a.Currency,&#xd;&#xa;           COUNT_BIG(*) AS Entries,&#xd;&#xa;           SUM(CASE e.Direction WHEN 2 THEN e.Amount ELSE 0 END) AS MoneyIn,&#xd;&#xa;           SUM(CASE e.Direction WHEN 1 THEN e.Amount ELSE 0 END) AS MoneyOut,&#xd;&#xa;           SUM(e.Amount) AS Volume&#xd;&#xa;    FROM dbo.LedgerEntries AS e&#xd;&#xa;    JOIN dbo.Accounts AS a ON a.Id = e.AccountId&#xd;&#xa;    WHERE a.Kind = 1&#xd;&#xa;      AND e.CreatedAtUtc &gt;= @FromUtc&#xd;&#xa;      AND e.CreatedAtUtc &lt; @ToUtc&#xd;&#xa;      AND (@Currency IS NULL OR a.Currency = @Currency)&#xd;&#xa;    GROUP BY e.AccountId, a.Currency&#xd;&#xa;    ORDER BY Volume DESC, e.AccountId&#xd;&#xa;    OPTION (RECOMPILE)" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x09009ACEC7A37B3DCF8863087A3F58BC1E740000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1749581271" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="62.2557" StatementEstRows="10" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x132587C6903F9F72" QueryPlanHash="0xDF346C6DE708871E" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="16" MemoryGrant="32384" CachedPlanSize="80" CompileTime="20" CompileCPU="20" CompileMemory="1336"><ThreadStat Branches="2" UsedThreads="32"><ThreadReservation NodeId="0" ReservedThreads="32"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="73.7204"><MissingIndex Database="[LedgerCore]" Schema="[dbo]" Table="[LedgerEntries]"><ColumnGroup Usage="INEQUALITY"><Column Name="[CreatedAtUtc]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[AccountId]" ColumnId="3"></Column><Column Name="[Direction]" ColumnId="4"></Column><Column Name="[Amount]" ColumnId="5"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="3584" RequiredMemory="30336" DesiredMemory="32384" RequestedMemory="32384" GrantWaitTime="0" MaxQueryMemory="2054504" GrantedMemory="32384" MaxUsedMemory="17672" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="81228" EstimatedPagesCached="81228" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="8236216"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-16T10:59:04.83" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000008_5441852A]" Table="[Accounts]" Schema="[dbo]" Database="[LedgerCore]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-14T18:18:27.21" ModificationCount="0" SamplingPercent="2.02303" Statistics="[_WA_Sys_00000006_59063A47]" Table="[LedgerEntries]" Schema="[dbo]" Database="[LedgerCore]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T10:59:04.73" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Accounts_OwnerUserId]" Table="[Accounts]" Schema="[dbo]" Database="[LedgerCore]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T11:20:13.11" ModificationCount="0" SamplingPercent="100" Statistics="[IX_LedgerEntries_TransactionId]" Table="[LedgerEntries]" Schema="[dbo]" Database="[LedgerCore]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-16T10:59:05.28" ModificationCount="0" SamplingPercent="100" Statistics="[PK_Accounts]" Table="[Accounts]" Schema="[dbo]" Database="[LedgerCore]"></StatisticsInfo><StatisticsInfo 