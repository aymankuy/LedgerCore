        <StmtSimple StatementText="SELECT p.EntryId,&#xD;&#xA;           p.TransactionId,&#xD;&#xA;           p.Type,&#xD;&#xA;           p.ReferenceId,&#xD;&#xA;           p.Description,&#xD;&#xA;           p.Amount,&#xD;&#xA;           @OpeningBalance + SUM(p.Amount) OVER (ORDER BY p.CreatedAtUtc, p.EntryId ROWS UNBOUNDED PRECEDING) AS BalanceAfter,&#xD;&#xA;           p.CreatedAtUtc&#xD;&#xA;    FROM (&#xD;&#xA;        SELECT TOP (@PageSize + 1)&#xD;&#xA;               e.Id AS EntryId,&#xD;&#xA;               e.TransactionId,&#xD;&#xA;               t.Type,&#xD;&#xA;               t.ReferenceId,&#xD;&#xA;               t.Description,&#xD;&#xA;               CASE e.Direction WHEN 2 THEN e.Amount ELSE -e.Amount END AS Amount,&#xD;&#xA;               e.CreatedAtUtc&#xD;&#xA;        FROM dbo.LedgerEntries AS e&#xD;&#xA;        JOIN dbo.LedgerTransactions AS t ON t.Id = e.TransactionId&#xD;&#xA;        WHERE e.AccountId = @AccountId&#xD;&#xA;          AND e.CreatedAtUtc &gt;= @StartUtc&#xD;&#xA;          AND (e.CreatedAtUtc &gt; @StartUtc OR e.Id &gt; @StartId)&#xD;&#xA;          AND e.CreatedAtUtc &lt; @ToUtc&#xD;&#xA;        ORDER BY e.CreatedAtUtc, e.Id&#xD;&#xA;    ) AS p&#xD;&#xA;    ORDER BY p.CreatedAtUtc, p.EntryId" StatementId="3" StatementCompId="6" StatementType="SELECT" StatementSqlHandle="0x0900F1597B3FA327F32D867B0F0861BC52250000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1717581157" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.28686" StatementEstRows="1001" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x4EE13EAD1E58981D" QueryPlanHash="0xBDD16E0A29DE3390" CardinalityEstimationModelVersion="160">
