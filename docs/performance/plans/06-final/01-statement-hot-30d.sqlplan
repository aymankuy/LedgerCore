        <StmtSimple StatementText="DECLARE @OpeningBalance decimal(19, 4) =&#xD;&#xA;        (SELECT b.Balance&#xD;&#xA;              - ISNULL((SELECT SUM(CASE e.Direction WHEN 2 THEN e.Amount ELSE -e.Amount END)&#xD;&#xA;                          FROM dbo.LedgerEntries AS e&#xD;&#xA;                          WHERE e.AccountId = @AccountId&#xD;&#xA;                            AND e.CreatedAtUtc &gt;= @StartUtc&#xD;&#xA;                            AND (e.CreatedAtUtc &gt; @StartUtc OR e.Id &gt; @StartId)), 0)&#xD;&#xA;         FROM dbo.fn_AccountBalance(@AccountId) AS b)" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x09004D7F5EB2BF048A5330E735D78B9C966C0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1717581157" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="23.4068" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB57925CA2C4B6DC7" QueryPlanHash="0x5DE59299F73B0639" CardinalityEstimationModelVersion="160">
