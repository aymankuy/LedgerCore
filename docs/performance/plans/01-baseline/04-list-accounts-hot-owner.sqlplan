<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT a.Id AS AccountId,&#xa;       a.Currency,&#xa;       a.Status,&#xa;       COALESCE(SUM(CASE e.Direction WHEN 2 THEN e.Amount ELSE -e.Amount END), 0) AS Balance,&#xa;       a.CreatedAtUtc&#xa;FROM dbo.Accounts AS a&#xa;LEFT JOIN dbo.LedgerEntries AS e ON e.AccountId = a.Id&#xa;WHERE a.OwnerUserId = @OwnerUserId AND a.Kind = 1&#xa;GROUP BY a.Id, a.Currency, a.Status, a.CreatedAtUtc&#xa;ORDER BY a.CreatedAtUtc, a.Id" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900388B56787DFD5ED6BCE98311C275D5050000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.676816" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xED369B9AC20A66EB" QueryPlanHash="0x123861260E235232" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1024" CachedPlanSize="80" CompileTime="11" CompileCPU="6" CompileMemory="720"><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="544" RequiredMemory="512" DesiredMemory="544" RequestedMemory="1024" GrantWaitTime="0" MaxQueryMemory="2058008" GrantedMemory="1024" MaxUsedMemory="0" LastRequestedMemory="1024" IsMemoryGrantFeedbackAdjusted="No: Accurate Grant"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="81228" EstimatedPagesCached="81228" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="8386384"></OptimizerHardwareDependentProperties