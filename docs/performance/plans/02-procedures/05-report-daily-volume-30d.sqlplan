<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT CAST(e.CreatedAtUtc AS date) AS Day,&#xd;&#xa;           a.Currency,&#xd;&#xa;           t.Type,&#xd;&#xa;           COUNT_BIG(DISTINCT e.TransactionId) AS Transactions,&#xd;&#xa;           SUM(e.Amount) AS Volume&#xd;&#xa;    FROM dbo.LedgerEntries AS e&#xd;&#xa;    JOIN dbo.LedgerTransactions AS t ON t.Id = e.TransactionId&#xd;&#xa;    JOIN dbo.Accounts AS a ON a.Id = e.AccountId&#xd;&#xa;    WHERE e.Direction = 1&#xd;&#xa;      AND e.CreatedAtUtc &gt;= @FromUtc&#xd;&#xa;      AND e.CreatedAtUtc &lt; @ToUtc&#xd;&#xa;      AND (@Currency IS NULL OR a.Currency = @Currency)&#xd;&#xa;    GROUP BY CAST(e.CreatedAtUtc AS date), a.Currency, t.Type&#xd;&#xa;    ORDER BY Day, a.Currency, t.Type&#xd;&#xa;    OPTION (RECOMPILE)" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x09005585696670F0AD4027E56C4109CBD32E0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1733581214" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="145.894" StatementEstRows="81758" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xAEE22190B39B674C" QueryPlanHash="0x3B227EA24A78FD5D" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="16" MemoryGrant="382344" CachedPlanSize="152" CompileTime="26" CompileCPU="26" CompileMemory="3536"><ThreadStat Branches="1" UsedThreads="16"><ThreadReservation NodeId="0" ReservedThreads="17"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="31.4065"><MissingIndex Database="[LedgerCore]