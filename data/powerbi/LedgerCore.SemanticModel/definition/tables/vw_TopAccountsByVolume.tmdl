table vw_TopAccountsByVolume
	lineageTag: 9328f7a4-b5ba-4c42-920f-f447654df0ab

	measure 'Customer volume' = CALCULATE(SUM(vw_TopAccountsByVolume[Volume]), vw_TopAccountsByVolume[Kind] = "Customer")
		formatString: #,0.00
		lineageTag: a810582d-935e-440c-ac0b-e716fdef2b83

	measure 'Top 10 customer volume' = IF(RANKX(ALLSELECTED(vw_TopAccountsByVolume[AccountId]), [Customer volume], , DESC) <= 10, [Customer volume])
		formatString: #,0.00
		lineageTag: d4d50c5c-752d-4183-bbdc-448ffd3a206f

	column AccountId
		dataType: string
