root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,xml,bicep}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false
dotnet_sort_system_directives_first = true

# EF Core generates these files; style rules do not apply to tool output.
[**/Migrations/*.cs]
generated_code = true

