<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage for the spec target: Domain and Application, measured by unit tests only. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[LedgerCore.Domain]*,[LedgerCore.Application]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
